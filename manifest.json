{
  "manifest_version": 3,
  "name": "Calendar Date Copier",
  "version": "1.1.0",
  "description": "Select dates from a calendar, set time slots, and copy formatted schedules to clipboard.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calendar Date Copier",
    "default_icon": {
      "16": "icons/16px.png",
      "48": "icons/48px.png",
      "128": "icons/128px.png"
    }
  },
  "icons": {
    "16": "icons/16px.png",
    "48": "icons/48px.png",
    "128": "icons/128px.png"
  },
  "permissions": [
    "storage"
  ]
}
